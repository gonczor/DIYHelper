GEMINI_API_KEY=replace-with-your-gemini-api-key
AUTH_HEADER=replace-with-a-random-secret
# Docker Compose development database. Use localhost instead of db when the API
# runs directly on the host.
DB_URL=postgresql+asyncpg://postgres:postgres@db:5432/diyhelper
# Tests create and delete this database. Its name must end with "_test".
TEST_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diyhelper_test

# File storage: "local" for development or "gcs" in production.
STORAGE_BACKEND=local
# Relative paths are resolved from the project root, not from the process working directory.
LOCAL_STORAGE_ROOT=data

# Required when STORAGE_BACKEND=gcs. Authentication uses GCP Application
# Default Credentials rather than a credentials file stored in this project.
GCS_STORAGE_BUCKET=replace-with-your-bucket-name
GCS_STORAGE_PREFIX=

# Delay between Hackaday requests and per-request timeout, in seconds.
KNOWLEDGE_REQUEST_DELAY_SECONDS=1.0
KNOWLEDGE_REQUEST_TIMEOUT_SECONDS=30.0
KNOWLEDGE_SEARCH_CANDIDATE_LIMIT=20
KNOWLEDGE_ARTICLE_LIMIT=5
KNOWLEDGE_TOKEN_BUDGET=50000

POSTGRES_DB=diyhelper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
